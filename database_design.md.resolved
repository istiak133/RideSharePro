## 🔗 ER Diagram (Entity-Relationship)

```mermaid
erDiagram
    users ||--o| user_profiles : "has profile"
    users ||--o| driver_documents : "has documents"
    users ||--o| driver_vehicles : "has vehicle"
    users ||--o| bank_accounts : "has bank"
    users ||--o| drivers : "driver info"
    users ||--o| driver_stats : "has stats"
    users ||--o{ device_tokens : "has devices"
    users ||--o{ payment_methods : "saved cards"
    users ||--o{ notifications_log : "receives notifications"
    
    users ||--o{ rides : "rider books rides"
    users ||--o{ rides : "driver accepts rides"
    users ||--o{ ratings : "gives ratings"
    users ||--o{ ratings : "receives ratings"
    users ||--o{ ride_requests : "gets ride requests"
    users ||--o{ disputes : "reports disputes"
    users ||--o{ driver_settlements : "has settlements"
    
    rides ||--o{ ride_route_points : "has GPS points"
    rides ||--o{ ride_requests : "sent to drivers"
    rides ||--o| payments : "has payment"
    rides ||--o{ ratings : "has ratings"
    rides ||--o{ otp_audit_log : "OTP attempts"
    rides ||--o{ scheduled_ride_jobs : "has jobs"
    rides ||--o{ disputes : "has disputes"
    
    admin_users ||--o{ audit_logs : "actions logged"
    admin_users ||--o{ verification_logs : "verifies drivers"
    admin_users ||--o{ broadcast_notifications : "sends broadcasts"
    admin_users ||--o{ disputes : "resolves disputes"

    fare_rules ||--o{ rides : "fare rules apply"
```

